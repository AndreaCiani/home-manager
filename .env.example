# Copia questo file in ".env" e personalizza i valori.
# Il file ".env" NON va committato (è già in .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=homemanager
POSTGRES_USER=homemanager
POSTGRES_PASSWORD=cambia_questa_password

# --- Backend (Spring Boot) ---
# La URL usa il nome del servizio Docker "db" come host.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/homemanager
SPRING_DATASOURCE_USERNAME=homemanager
SPRING_DATASOURCE_PASSWORD=cambia_questa_password
