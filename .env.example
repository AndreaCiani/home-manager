# Copy this file to ".env" and customize the values.
# The ".env" file must NOT be committed (it is already in .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=homemanager
POSTGRES_USER=homemanager
POSTGRES_PASSWORD=change_this_password

# --- Backend (Spring Boot) ---
# The URL uses the Docker service name "db" as the host.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/homemanager
SPRING_DATASOURCE_USERNAME=homemanager
SPRING_DATASOURCE_PASSWORD=change_this_password

# --- Production only (docker-compose.prod.yml) ---
# Use a STRONG POSTGRES_PASSWORD above in production.
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Required for prod.
TUNNEL_TOKEN=
# The prod compose already sets COOKIE_SECURE=true and REGISTRATION_OPEN=false.
